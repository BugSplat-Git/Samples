    <ProjectReference Include="..\MyDotNetFrameworkHostCrasherManaged\MyDotNetFrameworkHostCrasherManaged.csproj">
      <Project>{5e8a2f61-3c47-4d9b-b1e6-7a0c9d4f2b83}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <SetPlatform>Platform=AnyCPU</SetPlatform>

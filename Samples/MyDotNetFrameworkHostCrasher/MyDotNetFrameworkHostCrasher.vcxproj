  <ItemGroup>
    <!-- The managed assembly and its symbols, next to the exe. -->
    <ManagedOutput Include="$(ManagedOutDir)$(ManagedAssembly).dll" />
    <ManagedOutput Include="$(ManagedOutDir)$(ManagedAssembly).pdb" />
  </ItemGroup>
  <Target Name="CopyManagedOutput" AfterTargets="Link">
    <Copy SourceFiles="@(ManagedOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
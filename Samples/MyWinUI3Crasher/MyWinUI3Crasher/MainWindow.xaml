<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MyWinUI3Crasher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyWinUI3Crasher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MyWinUI3Crasher">

    <Grid Background="{StaticResource ScreenBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Full-width host provides the outer page padding; the inner column is capped
                 and centered (a Grid parent centers a Stretch + MaxWidth child, which a
                 ScrollViewer does not). -->
            <Grid Padding="32,24,32,28">
            <Grid MaxWidth="800" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar: logo + version chip + connected pill -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Source="ms-appx:///Images/bugsplat-logo.png"
                           Stretch="Uniform"
                           MaxHeight="26"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Grid.Column="0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="10" Padding="10,3">
                            <TextBlock x:Name="VersionChip" Text="v1.0.0" FontSize="12"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>
                        <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="10" Padding="10,3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource ConnectedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Connected" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Title block -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="BugSplat SDK &#183; Demo" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="DEMO" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Trigger an event. We catch it, group it, route it to your dashboard."
                               FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Section label -->
                <TextBlock Grid.Row="2" Text="TRIGGER AN EVENT" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0,0,10" />

                <!-- Event card grid -->
                <Grid Grid.Row="3" Margin="0,0,0,22" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="CrashCard" Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource EventCardButtonStyle}" Click="CrashCard_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="ms-appx:///Images/splat_crash.png"
                                   Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Crash" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Native crash &#183; stack + threads + memory" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="NonCrashErrorCard" Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource EventCardButtonStyle}" Click="NonCrashErrorCard_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="ms-appx:///Images/splat_error.png"
                                   Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Non-Crash Error" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Exception caught &#183; app keeps running" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="UserFeedbackCard" Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource EventCardButtonStyle}" Click="UserFeedbackCard_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="ms-appx:///Images/splat_feedback.png"
                                   Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="User Feedback" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Open the feedback sheet" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="HangCard" Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource EventCardButtonStyle}" Click="HangCard_Click">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="ms-appx:///Images/splat_hang.png"
                                   Width="40" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Hang" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Freeze main thread for 8 seconds" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Recent activity card -->
                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RECENT ACTIVITY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Grid.Column="1" x:Name="ViewDashboardLink" Content="View dashboard &#8599;"
                                             Padding="4,0" Click="ViewDashboard_Click" />
                        </Grid>

                        <StackPanel x:Name="RecentActivityPanel" Spacing="0" />

                        <TextBlock x:Name="RecentActivityEmpty" Text="No activity yet."
                                   FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Splat footer hint -->
                <TextBlock Grid.Row="5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,4">
                    <Run Text="Press " Foreground="#6B7280" FontSize="13" />
                    <Run Text="any 5 keys at once" FontWeight="SemiBold" Foreground="#4B5563" FontSize="13" />
                    <Run Text=" to send feedback &#8212; " Foreground="#6B7280" FontSize="13" />
                    <Run Text="splat your keyboard." FontFamily="Segoe Script" FontStyle="Italic"
                         Foreground="#1F73E8" FontSize="14" />
                </TextBlock>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

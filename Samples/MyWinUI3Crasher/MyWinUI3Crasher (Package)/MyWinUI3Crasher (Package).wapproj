<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <DebuggerType>NativeOnly</DebuggerType>
    <BackgroundTaskDebugEngines>NativeOnly</BackgroundTaskDebugEngines>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>9b5e0034-2d9e-4eed-8383-768d25b9ec95</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\MyWinUI3Crasher\MyWinUI3Crasher.vcxproj</EntryPointProjectUniqueName>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\BugSplat\x64\$(Configuration)\BugSplatMonitor.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BugSplatMonitor.exe</Link>
    </Content>
    <Content Include="..\..\..\BugSplat\x64\$(Configuration)\BugSplatRc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BugSplatRc.dll</Link>
    </Content>
    <Content Include="..\..\..\BugSplat\x64\$(Configuration)\BugSplatWer.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BugSplatWer.dll</Link>
    </Content>
    <Content Include="Images\bugsplat-logo.jpg" />
    <Content Include="Images\SplashScreen.scale-200.png" />
    <Content Include="Images\LockScreenLogo.scale-200.png" />
    <Content Include="Images\Square150x150Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.scale-200.png" />
    <Content Include="Images\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyWinUI3Crasher\MyWinUI3Crasher.vcxproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
  </ItemGroup>
  <!-- Custom target to ensure BugSplat files are always copied to AppX folder -->
  <Target Name="CopyBugSplatFilesToAppX" AfterTargets="_CopyFilesToLayoutDir;_GenerateCurrentProjectAppxManifest" BeforeTargets="_GenerateAppxPackageRecipeFile">
    <PropertyGroup>
      <AppXLayoutDir>$(OutDir)AppX\</AppXLayoutDir>
      <BugSplatSourceDir>..\..\..\BugSplat\x64\$(Configuration)\</BugSplatSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <BugSplatFiles Include="$(BugSplatSourceDir)BugSplatMonitor.exe" />
      <BugSplatFiles Include="$(BugSplatSourceDir)BugSplatRc.dll" />
      <BugSplatFiles Include="$(BugSplatSourceDir)BugSplatWer.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BugSplatFiles)" DestinationFolder="$(AppXLayoutDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" UseHardlinksIfPossible="false" Retries="3" RetryDelayMilliseconds="500" />
    <Message Text="Copied BugSplat files from $(BugSplatSourceDir) to $(AppXLayoutDir)" Importance="high" />
    <Message Text="  - BugSplatMonitor.exe: $([System.IO.File]::GetLastWriteTime('$(BugSplatSourceDir)BugSplatMonitor.exe'))" Importance="high" />
    <Message Text="  - BugSplatRc.dll: $([System.IO.File]::GetLastWriteTime('$(BugSplatSourceDir)BugSplatRc.dll'))" Importance="high" />
    <Message Text="  - BugSplatWer.dll: $([System.IO.File]::GetLastWriteTime('$(BugSplatSourceDir)BugSplatWer.dll'))" Importance="high" />
  </Target>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
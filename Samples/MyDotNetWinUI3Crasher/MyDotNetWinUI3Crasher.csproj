<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MyDotNetWinUI3Crasher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged so the sample runs with `dotnet run` and no MSIX/cert setup, and
         self-contained so it redistributes without a separate Windows App SDK Runtime
         install. To ship as MSIX instead, remove these two lines and add a Windows
         Application Packaging project (the Content items below flow into it unchanged). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Root of the BugSplat SDK layout (x64\<cfg>\bin holds BugSplat.dll + the monitor).
         Override to test a different SDK: /p:BugSplatDir=C:\path\to\BugSplat\ -->
    <BugSplatDir Condition="'$(BugSplatDir)' == ''">..\..\BugSplat\</BugSplatDir>
    <!-- Paths below concatenate directly, so an override must end in a separator. -->
    <BugSplatDir Condition="!HasTrailingSlash('$(BugSplatDir)')">$(BugSplatDir)\</BugSplatDir>
    <!-- The native runtime (BugSplat.dll + the monitor): this configuration's build when it
         exists, as in a repo build, otherwise the Release runtime the .NET SDK download ships.
         The C API is ABI-stable, so a Debug app runs fine with the Release BugSplat.dll. -->
    <BugSplatBin Condition="'$(BugSplatBin)' == '' and Exists('$(BugSplatDir)x64\$(Configuration)\bin\BugSplatMonitor.exe')">$(BugSplatDir)x64\$(Configuration)\bin\</BugSplatBin>
    <BugSplatBin Condition="'$(BugSplatBin)' == ''">$(BugSplatDir)x64\Release\bin\</BugSplatBin>
    <!-- BugSplatDotNet, built into the SDK layout for the same configuration. -->
    <BugSplatDotNetConfig>Release</BugSplatDotNetConfig>
    <BugSplatDotNetConfig Condition="'$(Configuration)' == 'Debug'">Debug</BugSplatDotNetConfig>
    <BugSplatDotNetBin>$(BugSplatDir)dotnet\$(BugSplatDotNetConfig)\net10.0\</BugSplatDotNetBin>
    <!-- Native crash DLL for the Mixed-Mode card. Built by MyDotNetCrasherNative.vcxproj
         (x64) and consumed here as a prebuilt file, since a .NET SDK project cannot build
         a vcxproj under `dotnet build`. MyDotNetWinUI3Crasher.sln declares the build-order
         dependency so an msbuild solution build produces it first; building this project
         standalone requires building ..\MyDotNetCrasherNative for the same configuration
         first. It is built from source, so it follows $(Configuration). -->
    <NativeCrasherBin>..\MyDotNetCrasherNative\bin\x64\$(Configuration)\</NativeCrasherBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
  </ItemGroup>

  <!-- BugSplatDotNet from the SDK's dotnet folder, next to the native binaries. -->
  <ItemGroup>
    <Reference Include="BugSplatDotNet" HintPath="$(BugSplatDotNetBin)BugSplatDotNet.dll" />
  </ItemGroup>

  <!-- BugSplat's native runtime files must sit next to the app executable: the SDK spawns
       "<app-dir>\BugSplatMonitor.exe" on a crash. Declaring them as Content with
       CopyToOutputDirectory is the recommended pattern - it flows to `dotnet build`,
       `dotnet publish`, AND MSIX packaging with no custom copy target. -->
  <ItemGroup>
    <Content Include="$(BugSplatBin)BugSplat.dll" Link="BugSplat.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BugSplatBin)BugSplatMonitor.exe" Link="BugSplatMonitor.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BugSplatBin)BugSplatReporter.exe" Link="BugSplatReporter.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BugSplatBin)BugSplatWer.dll" Link="BugSplatWer.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeCrasherBin)MyDotNetCrasherNative.dll" Link="MyDotNetCrasherNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeCrasherBin)MyDotNetCrasherNative.pdb" Link="MyDotNetCrasherNative.pdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts\SymbolUpload.ps1" />
  </ItemGroup>

  <!-- Sends the exe, DLLs and their .pdb files to BugSplat so crash stacks show file and line
       numbers. Needs Scripts\env.ps1 (or BUGSPLAT_CLIENT_ID / BUGSPLAT_CLIENT_SECRET); see the
       README. To skip it, build with /p:BugSplatSymbolUpload=false. -->
  <Target Name="BugSplatSymbolUpload" AfterTargets="Build" Condition="'$(BugSplatSymbolUpload)' != 'false'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\SymbolUpload.ps1&quot; -projectDir &quot;$(ProjectDir)\&quot; -outDir &quot;$(TargetDir)\&quot;" />
  </Target>

</Project>
